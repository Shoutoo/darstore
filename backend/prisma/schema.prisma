datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int            @id @default(autoincrement())
  nama          String
  email         String         @unique
  passwordHash  String         @map("password_hash")
  whatsapp      String?
  role          String         @default("user")
  isBlocked     Boolean        @default(false) @map("is_blocked")
  points        Int            @default(0)
  createdAt     DateTime?      @default(now()) @map("created_at")
  updatedAt     DateTime?      @updatedAt @map("updated_at")
  orders        Order[]
  pointHistory  PointHistory[]
  adminLogs     AdminLog[]

  @@map("users")
}

model Product {
  id        Int      @id @default(autoincrement())
  game      String
  namaItem  String   @map("nama_item")
  nominal   String?
  harga     Int
  icon      String?
  isActive  Int      @default(1) @map("is_active")
  orders    Order[]

  @@map("products")
}

model Order {
  id             Int          @id @default(autoincrement())
  invoiceNumber  String       @unique @map("invoice_number")
  userId         Int?         @map("user_id")
  productId      Int          @map("product_id")
  game           String?
  namaItem       String?      @map("nama_item")
  gameUserId     String?      @map("game_user_id")
  serverId       String?      @map("server_id")
  riotId         String?      @map("riot_id")
  waEmailGuest   String?      @map("wa_email_guest")
  status         String?
  paymentMethod  String?      @map("payment_method")
  paymentRef     String?      @map("payment_ref")
  qrisString     String?      @map("qris_string")
  qrisUrl        String?      @map("qris_url")
  totalHarga     Int          @map("total_harga")
  createdAt      DateTime?    @default(now()) @map("created_at")
  updatedAt      DateTime?    @updatedAt @map("updated_at")
  expiredAt      DateTime?    @map("expired_at")
  failureReason  String?      @map("failure_reason")
  pointsUsed     Int?         @default(0) @map("points_used")
  discountAmount Int?         @default(0) @map("discount_amount")

  user           User?        @relation(fields: [userId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])
  paymentLogs    PaymentLog[]
  pointHistory   PointHistory[]

  @@index([invoiceNumber])
  @@index([status])
  @@map("orders")
}

model PaymentLog {
  id           Int       @id @default(autoincrement())
  orderId      Int       @map("order_id")
  gatewayRef   String?   @map("gateway_ref")
  status       String?
  rawResponse  String?   @map("raw_response")
  createdAt    DateTime? @default(now()) @map("created_at")

  order        Order     @relation(fields: [orderId], references: [id])

  @@map("payment_logs")
}

model PointHistory {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  orderId       Int?      @map("order_id")
  pointsEarned  Int       @map("points_earned")
  description   String?
  createdAt     DateTime? @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id])
  order         Order?    @relation(fields: [orderId], references: [id])

  @@map("point_history")
}

model AdminLog {
  id         Int       @id @default(autoincrement())
  adminId    Int       @map("admin_id")
  action     String
  targetType String    @map("target_type")
  targetId   Int       @map("target_id")
  detail     String?
  createdAt  DateTime? @default(now()) @map("created_at")

  admin      User      @relation(fields: [adminId], references: [id])

  @@map("admin_logs")
}

model StoreSetting {
  id        Int       @id @default(autoincrement())
  key       String    @unique
  value     String?
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("store_settings")
}
